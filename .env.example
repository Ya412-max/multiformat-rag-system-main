# ====== LLM Provider Configuration ======
# 可选：qwen/custom
# qwen：预置DashScope地址，仅需要填写API_KEY、MODEL，无需BASE_URL
# custom：用于OpenAI、DeepSeek、智谱等所有OpenAI兼容接口，必须手动填写LLM_BASE_URL
#
# 示例1：使用qwen
# LLM_PROVIDER=qwen
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=qwen-turbo
#
# 示例2：使用custom调用原生OpenAI
# LLM_PROVIDER=custom
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-3.5-turbo
#
# 示例3：使用custom调用DeepSeek
# LLM_PROVIDER=custom
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

LLM_PROVIDER=qwen
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/
LLM_MODEL=qwen-turbo

# ====== Embedding Configuration (BGE-M3) ======
EMBEDDING_MODEL=model/bge-base-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ====== Vector Database (LanceDB) ======
LANCE_DB_PATH=./data/lancedb

# ====== Chunking Configuration ======
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ====== Retrieval Configuration ======
TOP_K=5
RERANK_ENABLED=True

# ====== API Configuration ======
API_HOST=0.0.0.0
API_PORT=8000

